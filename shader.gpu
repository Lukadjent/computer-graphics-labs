// PA2: позиції та нормалі у системі координат спостерігача.
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
uniform mat4 ModelViewProjectionMatrix;
uniform mat4 ModelViewMatrix;
uniform mat3 NormalMatrix;
varying vec3 positionEye;
varying vec3 normalEye;
void main() {
    positionEye = (ModelViewMatrix * vec4(vertex, 1.0)).xyz;
    normalEye = NormalMatrix * normal;
    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);
    gl_PointSize = 11.0;
}`;

// Phong: освітлення обчислюється для кожного фрагмента.
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform vec4 color;
uniform bool Lighting;
uniform vec3 LightPositionEye;
uniform vec3 Components;
uniform float Shininess;
varying vec3 positionEye;
varying vec3 normalEye;
void main() {
    if (!Lighting) {
        gl_FragColor = color;
        return;
    }
    vec3 N = normalize(normalEye);
    // Відкрита тонка поверхня освітлюється з обох боків.
    if (!gl_FrontFacing) N = -N;
    vec3 L = normalize(LightPositionEye - positionEye);
    // Ортографічна камера: напрямок до спостерігача сталий.
    vec3 V = vec3(0.0, 0.0, 1.0);
    float diffuseFactor = max(dot(N, L), 0.0);
    float specularFactor = 0.0;
    if (diffuseFactor > 0.0) {
        vec3 R = reflect(-L, N);
        specularFactor = pow(max(dot(R, V), 0.0), Shininess);
    }
    vec3 ambient = 0.16 * color.rgb * Components.x;
    vec3 diffuse = 0.76 * color.rgb * diffuseFactor * Components.y;
    vec3 specular = 0.85 * vec3(1.0, 0.94, 0.82) * specularFactor * Components.z;
    gl_FragColor = vec4(ambient + diffuse + specular, color.a);
}`;
